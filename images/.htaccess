# Harden uploads: disable script execution in images
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>

Options -ExecCGI
RemoveHandler .php .phtml .phar .pl .py .cgi .sh
RemoveType .php .phtml .phar .pl .py .cgi .sh

# Long-lived cache for product / brand / banner images
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
</IfModule>
