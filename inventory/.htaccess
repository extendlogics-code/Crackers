Options -MultiViews
RewriteEngine On

# External redirect GET/HEAD *.php → extensionless (POST unchanged).
# Root .htaccess also covers this; kept for inventory-scoped requests.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+(\S+?)\.php[\s?] [NC]
RewriteRule ^(.+)\.php$ /%1 [R=301,L]

# Serve existing files/directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Map extensionless requests to PHP files (e.g. /dashboard → /dashboard.php).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-z0-9]{1,8}$ [NC]
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

DirectoryIndex index.php
